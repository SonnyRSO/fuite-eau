rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accès ouvert en lecture/écriture : convient pour un usage privé à 3 personnes
    // qui connaissent seulement l'URL de l'appli. Si tu veux plus de sécurité,
    // ajoute l'authentification Firebase (voir README) et remplace "true" par
    // "request.auth != null".
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
